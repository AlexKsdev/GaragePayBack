generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum Currency {
  COINS
  GEMS
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(USER)

  // Player profile / game stats (surfaced on the account dashboard)
  rank            String  @default("Rookie")
  avatar          String?
  xp              Int     @default(0) // total lifetime XP — level & progress are derived from this
  coins           Int     @default(0)
  gems            Int     @default(0)
  playtimeMinutes Int     @default(0)
  kills           Int     @default(0)
  deaths          Int     @default(0)
  blocksPlaced    Int     @default(0)
  streak          Int     @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payments     Payment[]
  refreshTokens RefreshToken[]
  purchases    Purchase[]
  passwordResetTokens PasswordResetToken[]
}

model Product {
  id        String   @id @default(cuid())
  slug      String   @unique
  category  String
  name      String
  emoji     String
  rarity    String
  rarityRank Int     @default(0) // Common=1 … Legendary=5, for rarity sorting
  currency  Currency @default(COINS)
  price     Int
  badge     String?
  stats     String[]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]
}

model Purchase {
  id        String   @id @default(cuid())
  userId    String
  productId String
  currency  Currency
  price     Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String        @id @default(cuid())
  userId          String
  amount          Int // charged amount in the smallest currency unit (cents)
  gems            Int           @default(0) // gems credited to the user when this payment succeeds
  description     String?
  status          PaymentStatus @default(PENDING)
  stripePaymentId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id])
}

