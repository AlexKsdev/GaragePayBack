generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(USER)

  // Player profile / game stats (surfaced on the account dashboard)
  rank            String  @default("Rookie")
  avatar          String?
  xp              Int     @default(0) // total lifetime XP — level & progress are derived from this
  coins           Int     @default(0)
  gems            Int     @default(0)
  playtimeMinutes Int     @default(0)
  kills           Int     @default(0)
  deaths          Int     @default(0)
  blocksPlaced    Int     @default(0)
  streak          Int     @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payments     Payment[]
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String        @id @default(cuid())
  userId          String
  amount          Int
  description     String?
  status          PaymentStatus @default(PENDING)
  stripePaymentId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id])
}

