generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum Currency {
  COINS
  GEMS
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  name         String
  role         Role   @default(USER)

  // Set false to ban: blocks login and refresh, and fails the admin check.
  // A live access token still works until it expires (<= 15 min).
  active Boolean @default(true)

  // Email two-factor: a one-time code emailed at login. Mandatory for admins
  // (AdminGuard rejects an admin without it), optional for everyone else.
  twoFactorEnabled Boolean @default(false)

  // Player profile / game stats (surfaced on the account dashboard)
  rank            String  @default("Rookie")
  avatar          String?
  xp              Int     @default(0) // total lifetime XP — level & progress are derived from this
  coins           Int     @default(0)
  gems            Int     @default(0)
  playtimeMinutes Int     @default(0)
  kills           Int     @default(0)
  deaths          Int     @default(0)
  blocksPlaced    Int     @default(0)
  streak          Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments            Payment[]
  refreshTokens       RefreshToken[]
  purchases           Purchase[]
  passwordResetTokens PasswordResetToken[]
  questClaims         QuestClaim[]
}

// One row per reward taken: its presence is what marks a quest claimed for the
// day, and the unique key makes a double claim impossible even under a race.
model QuestClaim {
  id        String   @id @default(cuid())
  userId    String
  questKey  String
  day       String // 'YYYY-MM-DD' in the quest timezone
  claimedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questKey, day])
}

model Product {
  id         String   @id @default(cuid())
  slug       String   @unique
  category   String
  name       String
  emoji      String
  rarity     String
  rarityRank Int      @default(0) // Common=1 … Legendary=5, for rarity sorting
  currency   Currency @default(COINS)
  price      Int
  badge      String?
  stats      String[]
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  purchases Purchase[]
}

model Purchase {
  id        String   @id @default(cuid())
  userId    String
  productId String
  currency  Currency
  price     Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

// Refresh tokens are stored hashed (sha256), never in plaintext — a database
// leak must not hand over live sessions. Tokens rotate on every use: the old row
// is stamped `revokedAt` and a new one issued. Presenting an already-revoked
// token means it was replayed (i.e. stolen), which revokes the user's whole set.
model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String        @id @default(cuid())
  userId          String
  amount          Int // charged amount in the smallest currency unit (cents)
  gems            Int           @default(0) // gems credited to the user when this payment succeeds
  description     String?
  status          PaymentStatus @default(PENDING)
  stripePaymentId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id])
}

/// Forensic record of an admin acting on someone else's data. Append-only:
/// nothing in the app updates or deletes a row here.
model AdminAction {
  id String @id @default(cuid())

  /// Deliberately NOT a relation to User: the log has to outlive the accounts
  /// it describes. A foreign key would either cascade the evidence away with
  /// the actor or block their deletion outright.
  actorId    String
  action     AdminActionType
  targetType String
  targetId   String

  /// What changed — e.g. the old and new value. Never secrets or password hashes.
  metadata Json?

  /// The address the request arrived from — today that is the frontend's /api
  /// proxy, not the operator: Next's rewrite does not add x-forwarded-for, and
  /// trusting the header would be worse than useless, since it passes a
  /// client-supplied one straight through (verified 2026-07-16). Treat this as
  /// the calling hop until a trusted proxy sets a forwarded header and Express
  /// is configured with the matching `trust proxy` hop count.
  ip        String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

enum AdminActionType {
  USER_UPDATE
  USER_DELETE
  USER_ROLE_CHANGE
  USER_BALANCE_CHANGE
  PAYMENT_STATUS_UPDATE
  PRODUCT_CREATE
  PRODUCT_UPDATE
  // Not a deletion: `Purchase.product` has no cascade, and purchase history must
  // keep pointing at what was actually bought. `active: false` is what removal
  // from the shop means — and it is reversible.
  PRODUCT_DEACTIVATE
}
